# PostgreSQL
POSTGRES_CONTAINER_NAME=pg-database
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=app_db

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadminpassword

# Host user mapping for volume permissions
HOST_UID=1000
HOST_GID=1000

# Docker networking
DOCKER_NETWORK_NAME=pg_network
DOCKER_EXTERNAL_NETWORK=false

# S3/R2 backup storage
AWS_ACCESS_KEY_ID=xxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxx
AWS_DEFAULT_REGION=auto
R2_BUCKET=postgres-backups
R2_ENDPOINT=https://accountid.r2.cloudflarestorage.com

# Backup retention and schedule
KEEP_LOCAL=28
KEEP_REMOTE=14
BACKUP_SCHEDULE="0 */12 * * *"
